# LIVE par défaut. Le mock n'est utilisé que si DATA_MODE=mock.
DATA_MODE=live

# Seules ces deux valeurs sont obligatoires sur Vercel.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Facultatif mais recommandé si tu utilises plusieurs domaines Vercel/custom domain.
# Exemple: https://gold-live-analyzer.vercel.app
CTRADER_APP_URL=

# Facultatif. Si vide, l'app utilise automatiquement:
# https://TON-DOMAINE/api/auth/callback
CTRADER_REDIRECT_URI=

# Facultatif : force le compte live précis si plusieurs comptes sont autorisés.
CTRADER_ACCOUNT_ID=

# Facultatif : force un nom de symbole exact si ton broker n'utilise pas XAUUSD.
CTRADER_GOLD_SYMBOL=

